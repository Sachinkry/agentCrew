# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Model IDs (configurable tiers)
BEDROCK_MODEL_STRONG=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_MODEL_MID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MODEL_CHEAP=anthropic.claude-3-haiku-20240307-v1:0

# Observability
NEATLOGS_API_KEY=

# Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# Mock mode — set to 1 to run fully offline (no LLM calls, no network)
MOCK_LLM=1

# Business rules
DAILY_SPEND_CAP_CENTS=5000
PLATFORM_FEE_PCT=10
SIM_SEED=42

# DB (defaults to runs/autoshelf.sqlite)
DATABASE_URL=./runs/autoshelf.sqlite
