# ── Models via OpenRouter (openrouter.ai/keys) ───────────────────
OPENROUTER_API_KEY=
# Agent model (tool calling + reasoning). Alternatives: z-ai/glm-5.3, deepseek/deepseek-v4-pro
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Cheaper model for single-shot "cheap" tier calls
LLM_MODEL_CHEAP=z-ai/glm-5.3-flash
LLM_MAX_TOKENS=4096
# Max tokens (input + output + thinking) per team run. Helpers get grants from what is unspent (see GRANT_POLICY in src/core/budget.ts)
# Products the store sells and agents promote (comma-separated slugs: neatlogs, entire, crustdata)
FOCUS_PRODUCTS=neatlogs
RUN_TOKEN_BUDGET=10000
# Hard stop for model calls once total spend hits this (US cents; cost comes from OpenRouter)
LLM_BUDGET_CENTS=500

# ── Competitor research: Crustdata (app.crustdata.com → API key; free sandbox key available) ──
CRUSTDATA_API_KEY=

# ── Observability: neatlogs (agent traces incl. thinking) ───────────
# Project API key from app.neatlogs.com. Empty = spans print to the console.
NEATLOGS_API_KEY=
# Only for EU projects: https://eu.ingest.neatlogs.com
NEATLOGS_ENDPOINT=

# Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# Mock mode — set to 1 to run fully offline (no LLM calls, no network)
MOCK_LLM=1

# Business rules
DAILY_SPEND_CAP_CENTS=5000
PLATFORM_FEE_PCT=10
SIM_SEED=42

# DB (defaults to runs/autoshelf.sqlite)
DATABASE_URL=./runs/autoshelf.sqlite
