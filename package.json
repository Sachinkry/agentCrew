{
  "name": "autoshelf",
  "version": "0.1.0",
  "description": "Autonomous digital-goods store run by AI agents",
  "type": "module",
  "scripts": {
    "dev": "pnpm css:build && tsx --env-file-if-exists=.env src/store/index.tsx",
    "css:build": "tailwindcss -i src/styles/globals.css -o public/styles.css --minify",
    "css:watch": "tailwindcss -i src/styles/globals.css -o public/styles.css --watch",
    "sim": "tsx --env-file-if-exists=.env src/sim/run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests --ext .ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "eval:compare": "tsx --env-file-if-exists=.env src/eval/compare.ts",
    "export:cfo": "tsx --env-file-if-exists=.env src/eval/export_cfo.ts",
    "approve:all": "tsx --env-file-if-exists=.env src/services/approvals.ts --approve-all",
    "agents": "tsx --env-file-if-exists=.env src/agents/run-live.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "neatlogs": "^1.1.28",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
